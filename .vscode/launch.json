{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run ResCraft Project",
            "type": "chrome",
            "request": "launch",
            "preLaunchTask": "Start Project",
            "url": "http://localhost/login.html",
            "webRoot": "${workspaceFolder}",
            "userDataDir": "${workspaceFolder}/.vscode/chrome-profile"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Open Login Page",
            "file": "${workspaceFolder}/login.html"
        }
    ]
}